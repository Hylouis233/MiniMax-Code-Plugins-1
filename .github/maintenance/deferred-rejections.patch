+// Observe a pending operation before yielding to fixture I/O. Return an async
+// assertion callback that preserves its original value or rejection reason;
+// no rejection is discarded and assert.rejects keeps checking the exact type.
+function observeForRejection(promise) {
+  const settled = Promise.allSettled([promise]);
+  return async () => {
+    const [outcome] = await settled;
+    if (outcome.status === "rejected") throw outcome.reason;
+    return outcome.value;
+  };
+}
