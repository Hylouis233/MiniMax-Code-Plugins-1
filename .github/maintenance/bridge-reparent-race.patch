diff --git a/plugins/Hylouis233/cli-agent-bridge/tests/process-tree.test.mjs b/plugins/Hylouis233/cli-agent-bridge/tests/process-tree.test.mjs
index 7d5e040..e114da4 100644
--- a/plugins/Hylouis233/cli-agent-bridge/tests/process-tree.test.mjs
+++ b/plugins/Hylouis233/cli-agent-bridge/tests/process-tree.test.mjs
@@ -1058,3 +1058,117 @@ test("BSD process snapshots reject truncation and malformed records", async () =
     runUtility: async () => ({ exitCode: 0, stdout: valid + "malformed\n" }),
   }), null);
 });
+
+function reparentStatLine(pid, parent, startIdentity) {
+  const fields = ['S', String(parent), String(pid), String(pid)];
+  while (fields.length < 20) fields.push('0');
+  fields[19] = String(startIdentity);
+  return `${pid} (fixture) ${fields.join(' ')}\n`;
+}
+const reparentGone = () => Object.assign(new Error('gone'), { code: 'ENOENT' });
+const reparentDirectory = (pid) => ({ name: String(pid), isDirectory: () => true });
+function reparentedChildFixture({ marker = 'owned-run', recycledAt = Infinity, goneAt = Infinity } = {}) {
+  let childReads = 0;
+  let rootAlive = true;
+  let markerReads = 0;
+  const fsOps = {
+    readdir: async (target) => {
+      if (target === '/fixture/100/task') return [reparentDirectory(100)];
+      if (target === '/fixture/200/task') return [reparentDirectory(200)];
+      if (target === '/fixture') return [reparentDirectory(200)];
+      throw reparentGone();
+    },
+    readFile: async (target) => {
+      if (target === '/fixture/100/stat') {
+        if (!rootAlive) throw reparentGone();
+        return reparentStatLine(100, 1, 10);
+      }
+      if (target === '/fixture/100/task/100/children') return '200\n';
+      if (target === '/fixture/200/stat') {
+        ++childReads;
+        rootAlive = false;
+        if (childReads >= goneAt) throw reparentGone();
+        return reparentStatLine(200, 1, childReads >= recycledAt ? 21 : 20);
+      }
+      if (target === '/fixture/200/environ') {
+        ++markerReads;
+        return Buffer.from(`CLI_AGENT_BRIDGE_RUN_ID=${marker}\0`);
+      }
+      if (target === '/fixture/200/task/200/children') return '\n';
+      throw reparentGone();
+    },
+  };
+  return {
+    treeState: { knownPids: new Set([100]), knownStarts: new Map([[100, '10']]), runMarker: 'owned-run' },
+    fsOps,
+    get markerReads() { return markerReads; },
+  };
+}
+test('Linux ancestry recovers a marker-verified child reparented after parent validation', async () => {
+  const f = reparentedChildFixture();
+  const snapshot = await refreshProcessTree({ pid: 100 }, f.treeState, {
+    platform: 'linux', procRoot: '/fixture', fsOps: f.fsOps,
+  });
+  assert.equal(f.treeState.processIdentityUncertain, undefined,
+    'same-generation marker evidence should resolve the parent-change race');
+  assert.ok(f.markerReads >= 2, 'recovery requires stable repeated marker observations');
+  assert.ok(f.treeState.knownPids.has(200), 'the reparented live child must remain tracked');
+  assert.equal(f.treeState.knownStarts.get(200), '20');
+  assert.ok(snapshot.some((item) => item.pid === 200));
+});
+test('Linux ancestry does not recover a reparented child with a different marker', async () => {
+  const f = reparentedChildFixture({ marker: 'another-run' });
+  await refreshProcessTree({ pid: 100 }, f.treeState, {
+    platform: 'linux', procRoot: '/fixture', fsOps: f.fsOps,
+  });
+  assert.equal(f.treeState.processIdentityUncertain, true);
+  assert.equal(f.treeState.knownPids.has(200), false);
+});
+test('Linux reparent recovery does not accept a PID reused during marker inspection', async () => {
+  const f = reparentedChildFixture({ recycledAt: 3 });
+  await assert.rejects(refreshProcessTree({ pid: 100 }, f.treeState, {
+    platform: 'linux', procRoot: '/fixture', fsOps: f.fsOps,
+  }), /identity changed/u);
+  assert.equal(f.treeState.processIdentityUncertain, true);
+  assert.equal(f.treeState.knownPids.has(200), false);
+});
+
+
+test('Linux reparent recovery rechecks PID identity after stable marker scans', async () => {
+  const f = reparentedChildFixture({ recycledAt: 6 });
+  await refreshProcessTree({ pid: 100 }, f.treeState, {
+    platform: 'linux', procRoot: '/fixture', fsOps: f.fsOps,
+  });
+  assert.equal(f.treeState.processIdentityUncertain, true);
+  assert.equal(f.treeState.knownPids.has(200), false);
+  assert.equal(f.treeState.knownStarts.get(200), '20', 'original identity remains immutable');
+});
+
+test('Linux reparent recovery tolerates a verified child exiting before enrollment', async () => {
+  const f = reparentedChildFixture({ goneAt: 6 });
+  const snapshot = await refreshProcessTree({ pid: 100 }, f.treeState, {
+    platform: 'linux', procRoot: '/fixture', fsOps: f.fsOps,
+  });
+  assert.equal(f.treeState.processIdentityUncertain, undefined);
+  assert.equal(f.treeState.knownPids.has(200), false);
+  assert.equal(snapshot.some((item) => item.pid === 200), false);
+});
+
+test('Linux parent changes without a run marker stay fail-closed', async () => {
+  const f = reparentedChildFixture();
+  delete f.treeState.runMarker;
+  await refreshProcessTree({ pid: 100 }, f.treeState, {
+    platform: 'linux', procRoot: '/fixture', fsOps: f.fsOps,
+  });
+  assert.equal(f.treeState.processIdentityUncertain, true);
+  assert.equal(f.treeState.knownPids.has(200), false);
+});
+
+test('Linux marker-verified reparent recovery never clears prior uncertainty', async () => {
+  const f = reparentedChildFixture();
+  f.treeState.processIdentityUncertain = true;
+  await refreshProcessTree({ pid: 100 }, f.treeState, {
+    platform: 'linux', procRoot: '/fixture', fsOps: f.fsOps,
+  });
+  assert.equal(f.treeState.processIdentityUncertain, true);
+});
